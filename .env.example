# Copy this file to .env locally. On Render, use the Environment page instead.
# Demo mode works without any keys. Never commit a real .env file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ALPHA_VANTAGE_API_KEY=
# Replace this with your app name and a real contact email for SEC access.
SEC_USER_AGENT=
# Conservative free-tier controls. These are in memory and reset on restart.
CACHE_SECONDS=3600
REQUESTS_PER_HOUR=12
GLOBAL_REQUESTS_PER_HOUR=30
ALPHA_DAILY_BUDGET=25
# Keep third-party tracing off unless you explicitly decide to enable it.
LANGSMITH_TRACING=false
